{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["react", "typescript", "oxc"],
  "env": {
    "browser": true
  },
  "rules": {
    "react/rules-of-hooks": "error",
    "react/only-export-components": [
      "warn",
      {
        "allowConstantExport": true,
        "allowExportNames": ["useRootStore"]
      }
    ],
    "@typescript-eslint/no-explicit-any": "warn",
    "@typescript-eslint/no-floating-promises": "error",
    "no-restricted-imports": [
      "error",
      {
        "paths": [
          {
            "name": "react",
            "importNames": ["FormEvent"],
            "message": "Обработчик отправки типизируется SubmitEvent (правила разработки, раздел 11)."
          }
        ]
      }
    ],
    "typescript/no-restricted-types": [
      "error",
      {
        "types": {
          "React.FormEvent": {
            "message": "Обработчик отправки типизируется SubmitEvent (правила разработки, раздел 11)."
          }
        }
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "src/modules/admins/{list,create,reset-password}/**",
        "src/modules/admins/AdminsPage.tsx",
        "src/modules/admins/admin-display.ts",
        "src/modules/tags/{list,form}/**",
        "src/modules/tags/TagsPage.tsx",
        "src/modules/tags/tags-display.ts",
        "src/modules/session/{login,change-password}/**",
        "src/modules/session/LoginPage.tsx",
        "src/modules/session/ChangePasswordPage.tsx",
        "src/modules/compositions/{list,create,edit,card}/**",
        "src/modules/compositions/CompositionsPage.tsx",
        "src/modules/compositions/CompositionCardPage.tsx",
        "src/modules/compositions/composition-display.ts",
        "src/modules/compositions/use-tag-options.ts",
        "src/shared/hooks/**",
        "src/shared/ui/ListPagination.tsx",
        "src/shared/ui/ListWithFilters.tsx"
      ],
      "rules": {
        "func-style": ["error", "expression"]
      }
    }
  ]
}
